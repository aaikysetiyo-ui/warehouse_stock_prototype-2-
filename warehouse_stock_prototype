function editOpNote(id){const o=state.opnames.find(x=>x.id===id);if(!o)return;const note=prompt('Masukkan catatan untuk hasil opname:',o.note||'');if(note===null)return;o.note=note.trim();log('Perbarui catatan opname',`${o.id} ${o.sku}: ${o.note||'(catatan dikosongkan)'}`);save();renderAll();toast('Catatan opname disimpan')}
function exportOpname(){const rows=state.opnames.filter(o=>o.status==='approved');const header=['ID Opname','Tanggal','Kode barang','Nama Barang','Lokasi','Satuan','Stok sistem','Stok fisik','Selisih','Catatan'];const data=rows.map(o=>[o.id,o.time,o.sku,o.name,o.location||'',o.unit||'PCS',Number(o.system),Number(o.physical),Number(o.diff),o.note||'']);if(window.XLSX){const ws=XLSX.utils.aoa_to_sheet([header,...data]);ws['!cols']=[{wch:16},{wch:20},{wch:20},{wch:34},{wch:22},{wch:12},{wch:14},{wch:14},{wch:12},{wch:40}];ws['!autofilter']={ref:ws['!ref']};ws['!freeze']={xSplit:0,ySplit:1,topLeftCell:'A2',activePane:'bottomLeft',state:'frozen'};const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Hasil Opname');XLSX.writeFile(wb,'hasil_stok_opname.xlsx');}else{downloadText('hasil_stok_opname.tsv',[header,...data].map(r=>r.map(v=>String(v??'').replace(/[\t\r\n]/g,' ')).join('\t')).join('\n'),'text/tab-separated-values;charset=utf-8');toast('Pustaka Excel tidak tersedia; file TSV dipisahkan dengan tab agar setiap nilai masuk ke kolom Excel yang terpisah.');return}toast(`Export ${rows.length} hasil opname yang disetujui ke Excel`)}
function deleteOp(id){const o=state.opnames.find(x=>x.id===id);if(!o)return;if(o.status==='approved'){toast('Hasil yang sudah disetujui tidak dapat dihapus karena stok sistem sudah berubah. Buat opname koreksi agar jejak audit tetap terjaga.');return}if(!confirm(`Hapus hitungan ${o.id} untuk SKU ${o.sku} di lokasi ${o.location}? Tindakan ini tidak dapat dibatalkan.`))return;state.opnames=state.opnames.filter(x=>x.id!==id);log('Hapus hitungan opname',`${o.id}: ${o.sku} @ ${o.location}; fisik ${o.physical}`);save();renderAll();toast('Hitungan opname dihapus')}
function deleteAllOpnames(){if(!state.opnames.length)return toast('Daftar stok opname sudah kosong.');const approved=state.opnames.filter(o=>o.status==='approved').length;const msg=`Hapus SEMUA ${state.opnames.length} catatan stok opname (termasuk ${approved} yang sudah disetujui)? Catatan audit akan hilang, tetapi saldo stok di Master Barang TIDAK berubah. Export hasil opname terlebih dahulu jika ingin menyimpan laporan.`;if(!confirm(msg))return;if(!confirm('Konfirmasi terakhir: hapus seluruh catatan stok opname sekarang?'))return;const count=state.opnames.length;state.opnames=[];log('Hapus semua catatan stok opname',`${count} catatan dihapus; saldo master barang tidak berubah.`);save();renderAll();toast(`Semua ${count} catatan opname dihapus`)}
function detailOp(id){const o=state.opnames.find(x=>x.id===id);if(!o)return;alert(`Sesi: ${o.id}\nSKU: ${o.sku} — ${o.name}\nLokasi: ${o.location||'-'}\nStok sistem saat hitung: ${o.system}\nStok fisik: ${o.physical}\nSelisih: ${o.diff}\nCatatan: ${o.note||'-'}\nDihitung oleh: ${o.createdBy}\nStatus: ${o.status}\nDisetujui oleh: ${o.approvedBy||'-'}\nWaktu persetujuan: ${o.approvedAt||'-'}`)}
function openFindingModal(){document.getElementById('modalRoot').innerHTML=`<div class="modalback" onclick="if(event.target===this)closeModal()"><div class="modal"><h2>Tambah temuan barang</h2><p class="sub" style="margin-bottom:16px">Untuk barang yang ditemukan secara fisik tetapi belum ada di stok sistem.</p><div class="formgrid"><div class="field"><label>Kode barang / SKU *</label><input id="fSku" placeholder="Ketik kode part"></div><div class="field"><label>Nama barang *</label><input id="fName" placeholder="Ketik nama barang"></div><div class="field"><label>Lokasi *</label><input id="fLoc" placeholder="Contoh: Rak A-01"></div><div class="field"><label>Satuan</label><input id="fUnit" value="PCS"></div><div class="field span2"><label>Qty temuan *</label><input id="fQty" type="number" min="0" step="any" placeholder="Jumlah barang ditemukan"></div></div><div class="field"><label>Catatan</label><textarea id="fNote" placeholder="Contoh: tidak ada di master stok, ditemukan saat pemeriksaan…"></textarea></div><div class="modalactions"><button class="btn" onclick="closeModal()">Batal</button><button class="btn primary" onclick="saveFinding()">Simpan temuan</button></div></div></div>`}function saveFinding(){const sku=document.getElementById('fSku').value.trim(),name=document.getElementById('fName').value.trim(),location=document.getElementById('fLoc').value.trim(),unit=document.getElementById('fUnit').value.trim()||'PCS',qty=Number(document.getElementById('fQty').value),note=document.getElementById('fNote').value.trim();if(!sku||!name||!location)return toast('Kode barang, nama barang, dan lokasi wajib diisi.');if(document.getElementById('fQty').value===''||!Number.isFinite(qty)||qty<0)return toast('Qty temuan harus angka nol atau lebih.');const existing=state.findings.find(f=>f.sku.toLowerCase()===sku.toLowerCase()&&f.location.toLowerCase()===location.toLowerCase());if(existing){existing.qty=Number(existing.qty)+qty;existing.note=[existing.note,note,'Qty temuan digabung'].filter(Boolean).join(' | ');existing.updatedAt=now();log('Tambah qty temuan',`${sku} @ ${location}; tambahan ${qty}; total ${existing.qty}`)}else{state.findings.unshift({id:'TM-'+Date.now().toString().slice(-7),time:now(),sku,name,location,unit,qty,note,createdBy:user()});log('Simpan temuan barang',`${sku} ${name} @ ${location}; qty ${qty}`)}save();closeModal();renderAll();toast('Temuan berhasil disimpan')}function renderFindings(){const body=document.getElementById('findingsBody');if(!body)return;const q=(document.getElementById('findingSearch')?.value||'').toLowerCase();const rows=(state.findings||[]).filter(f=>[f.id,f.time,f.sku,f.name,f.location,f.unit,f.note,f.createdBy].join(' ').toLowerCase().includes(q));body.innerHTML=rows.map(f=>`<tr><td>${esc(f.time)}</td><td><b class="sku">${esc(f.sku)}</b></td><td>${esc(f.name)}</td><td>${esc(f.location)}</td><td>${esc(f.unit)}</td><td><b>${fmt(f.qty)}</b></td><td>${esc(f.note||'—')}</td><td>${esc(f.createdBy)}</td><td><button class="btn small danger" onclick="deleteFinding('${f.id}')">Hapus</button></td></tr>`).join('')||'<tr><td colspan="9" class="empty">Belum ada temuan. Klik “Tambah temuan” untuk menyimpan barang di luar stok.</td></tr>'}function deleteFinding(id){const f=state.findings.find(x=>x.id===id);if(!f)return;if(!confirm(`Hapus temuan ${f.sku} @ ${f.location}?`))return;state.findings=state.findings.filter(x=>x.id!==id);log('Hapus temuan barang',`${f.sku} @ ${f.location}`);save();renderAll();toast('Temuan dihapus')}function exportFindings(){const rows=state.findings||[];const header=['ID Temuan','Tanggal','Kode barang','Nama Barang','Lokasi','Satuan','Qty Temuan','Catatan','Pengguna'];const data=rows.map(f=>[f.id,f.time,f.sku,f.name,f.location,f.unit,f.qty,f.note||'',f.createdBy]);if(XLSX){const ws=XLSX.utils.aoa_to_sheet([header,...data]);ws['!cols']=[{wch:16},{wch:20},{wch:20},{wch:34},{wch:22},{wch:12},{wch:14},{wch:36},{wch:18}];ws['!autofilter']={ref:ws['!ref']};const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Temuan');XLSX.writeFile(wb,'daftar_temuan.xlsx')}else downloadText('daftar_temuan.tsv',[header,...data].map(r=>r.map(v=>String(v??'').replace(/[\t\r\n]/g,' ')).join('\t')).join('\n'),'text/tab-separated-values;charset=utf-8');toast(`Export ${rows.length} temuan`) }
function renderLogs(){const body=document.getElementById('logsBody');if(!body)return;const q=(document.getElementById('logSearch')?.value||'').toLowerCase(),arr=state.logs.filter(l=>(l.time+' '+l.action+' '+l.detail+' '+l.user).toLowerCase().includes(q));body.innerHTML=arr.map(l=>`<tr><td>${esc(l.time)}</td><td><b>${esc(l.action)}</b></td><td>${esc(l.detail)}</td><td>${esc(l.user)}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">Belum ada riwayat.</td></tr>'}
load();renderAll();
</script></body></html>
