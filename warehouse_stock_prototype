<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Warehouse Stock — Prototype v0.7</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
:root{--bg:#f4f7fb;--panel:#fff;--ink:#182230;--muted:#6b7788;--line:#e5eaf1;--nav:#142438;--accent:#1769e0;--green:#16845b;--red:#c33d4b;--amber:#b7791f}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.app{display:grid;grid-template-columns:245px 1fr;min-height:100vh}.sidebar{background:var(--nav);color:#d9e4f1;padding:22px 14px}.brand{font-size:18px;font-weight:800;color:#fff;padding:8px 12px 24px;display:flex;gap:10px;align-items:center}.brand-icon{display:grid;place-items:center;background:#1c75ee;color:white;width:34px;height:34px;border-radius:10px}.nav-label{font-size:10px;text-transform:uppercase;letter-spacing:1.4px;color:#8fa2b9;padding:12px}.nav button{width:100%;border:0;background:transparent;color:#c8d5e5;text-align:left;padding:12px;border-radius:9px;cursor:pointer;margin:2px 0;font-size:13px}.nav button.active,.nav button:hover{background:#233b56;color:#fff}.nav button span{display:inline-block;width:27px;color:#8eabc9}.sidebar-foot{font-size:11px;color:#91a4ba;padding:20px 12px}.main{min-width:0}.topbar{height:70px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;gap:15px}.crumb{color:var(--muted);font-size:12px}.topright{display:flex;align-items:center;gap:12px}.avatar{width:34px;height:34px;border-radius:50%;background:#dbeafe;color:#174ea6;display:grid;place-items:center;font-weight:800}.user-select{border:1px solid var(--line);border-radius:8px;padding:8px;background:#fff;color:var(--ink)}.content{padding:28px 30px;max-width:1500px;margin:auto}.pagehead{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:22px}.eyebrow{color:var(--accent);font-size:11px;text-transform:uppercase;font-weight:800;letter-spacing:1.3px}.pagehead h1{font-size:26px;letter-spacing:-.7px;margin:5px 0}.sub{color:var(--muted);margin:0}.btn{border:1px solid var(--line);border-radius:8px;padding:9px 13px;background:white;color:var(--ink);font-weight:650;cursor:pointer}.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.btn.danger{color:var(--red)}.btn.small{padding:6px 9px;font-size:12px}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:20px}.stat,.panel{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:18px}.stat-top{display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.stat-icon{width:32px;height:32px;border-radius:9px;background:#eef5ff;color:var(--accent);display:grid;place-items:center}.stat-num{font-size:27px;font-weight:800;letter-spacing:-.8px;margin:10px 0 2px}.stat-note{font-size:11px;color:var(--muted)}.layout2{display:grid;grid-template-columns:1.45fr 1fr;gap:16px}.panel{margin-bottom:16px}.panelhead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px}.panelhead h3{font-size:15px;margin:0}.panelhead p{font-size:12px;color:var(--muted);margin:3px 0 0}.pill{display:inline-flex;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:700;background:#edf2f7;color:#516173}.pill.green{background:#e6f7ef;color:var(--green)}.pill.red{background:#ffedf0;color:var(--red)}.pill.amber{background:#fff4dd;color:var(--amber)}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;white-space:nowrap}th{text-align:left;font-size:11px;color:var(--muted);font-weight:700;background:#f8fafc;padding:11px 12px;border-bottom:1px solid var(--line)}td{padding:12px;border-bottom:1px solid #edf0f5;font-size:12px}tbody tr:last-child td{border-bottom:0}.sku{font-weight:800;color:#245ca6}.muted{color:var(--muted)}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:14px}.search{border:1px solid var(--line);border-radius:8px;padding:9px 11px;min-width:220px;background:#fff}.field{display:flex;flex-direction:column;gap:5px;margin-bottom:13px}.field label{font-size:12px;color:#526174;font-weight:700}.field input,.field select,.field textarea{border:1px solid #dbe2eb;border-radius:8px;padding:10px;font:inherit;width:100%;background:#fff}.field textarea{min-height:70px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 13px}.span2{grid-column:1/-1}.empty{text-align:center;padding:30px;color:var(--muted)}.uploadbox{border:1.5px dashed #b8c8dc;background:#f8fbff;border-radius:12px;padding:28px;text-align:center}.uploadbox input{margin:12px auto;max-width:100%}.note{background:#fff8e8;border:1px solid #f4dfac;color:#78561a;padding:12px;border-radius:9px;font-size:12px;margin:12px 0}.success{background:#e9f8f0;color:#176844;border:1px solid #c8ebd8;padding:10px;border-radius:8px;margin:10px 0;font-size:12px}.tabs{display:flex;gap:5px;border-bottom:1px solid var(--line);margin-bottom:14px}.tabs button{border:0;background:transparent;padding:10px 12px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent}.tabs button.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:800}.hidden{display:none!important}.diffpos{color:var(--green);font-weight:800}.diffneg{color:var(--red);font-weight:800}.footnote{font-size:11px;color:var(--muted);margin-top:10px}.activity{display:flex;gap:11px;padding:11px 0;border-bottom:1px solid #edf0f5}.dot{width:8px;height:8px;border-radius:50%;background:var(--accent);margin-top:6px;flex-shrink:0}.activity strong{font-size:12px}.activity p{margin:2px 0;color:var(--muted);font-size:11px}.toast{position:fixed;bottom:20px;right:20px;background:#142438;color:white;padding:12px 16px;border-radius:9px;box-shadow:0 8px 30px #0002;z-index:10}.modalback{position:fixed;inset:0;background:#12203388;display:grid;place-items:center;padding:20px;z-index:20}.modal{background:white;border-radius:14px;padding:22px;width:min(560px,100%);max-height:90vh;overflow:auto}.modal h2{font-size:18px;margin:0 0 18px}.modalactions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.footer{font-size:11px;color:var(--muted);text-align:center;padding:15px}.tag{font-size:11px;background:#eaf2ff;color:#235db4;padding:5px 8px;border-radius:6px}@media(max-width:1000px){.app{grid-template-columns:1fr}.sidebar{padding:12px}.brand{padding:4px 8px 12px}.nav{display:flex;overflow:auto}.nav-label,.sidebar-foot{display:none}.nav button{white-space:nowrap;width:auto}.topbar{padding:0 18px}.content{padding:20px 16px}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.layout2{grid-template-columns:1fr}}@media(max-width:560px){.cards{grid-template-columns:1fr 1fr;gap:8px}.stat{padding:12px}.stat-num{font-size:22px}.pagehead{display:block}.pagehead .btn{margin-top:12px}.formgrid{grid-template-columns:1fr}.span2{grid-column:auto}.topbar{height:auto;padding:12px;align-items:flex-start}.topright{gap:6px}.user-select{max-width:135px}.content{padding:16px 10px}}
</style></head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="brand-icon">▦</div><div>Warehouse<span style="color:#7eafff">Stock</span></div></div>
    <div class="nav-label">Workspace</div>
    <nav class="nav" id="nav">
      <button class="active" data-page="dashboard"><span>▦</span>Dashboard</button>
      <button data-page="items"><span>▤</span>Master Barang</button>
      <button data-page="import"><span>⇧</span>Import Excel</button>
      <button data-page="opname"><span>☷</span>Stok Opname</button>
      <button data-page="reports"><span>▥</span>Laporan & Riwayat</button>
      <button data-page="findings"><span>⚑</span>Temuan</button>
    </nav>
    <div class="sidebar-foot">PROTOTIPE v0.7<br>Data awal kosong · simulasi browser.</div>
  </aside>
  <main class="main">
    <header class="topbar">
      <div>
        <div class="crumb">Warehouse / <strong id="crumb">Dashboard</strong></div>
        <div style="font-weight:750;margin-top:3px">Stock Control Center</div>
      </div>
      <div class="topright">
        <span class="muted" style="font-size:12px">Pengguna aktif</span>
        <select class="user-select" id="userSelect"><option>Pengguna 1</option><option>Pengguna 2</option></select>
        <div class="avatar" id="avatar">R</div>
      </div>
    </header>
    <div class="content">
      <section id="page-dashboard" class="page">
        <div class="pagehead">
          <div><div class="eyebrow">Ringkasan operasional</div><h1>Dashboard</h1><p class="sub">Pantau kondisi stok warehouse hari ini.</p></div>
          <button class="btn primary" onclick="showPage('opname')">＋ Mulai stok opname</button>
        </div>
        <div class="cards" id="stats"></div>
        <div class="layout2">
          <div class="panel">
            <div class="panelhead">
              <div><h3>Stok terbaru</h3><p>Ringkasan barang berdasarkan stok sistem</p></div>
              <button class="btn small" onclick="showPage('items')">Lihat semua →</button>
            </div>
            <div class="tablewrap">
              <table>
                <thead><tr><th>SKU / BARANG</th><th>LOKASI</th><th>STOK</th><th>STATUS</th></tr></thead>
                <tbody id="dashItems"></tbody>
              </table>
            </div>
          </div>
          <div class="panel">
            <div class="panelhead">
              <div><h3>Aktivitas terbaru</h3><p>Perubahan data yang tercatat</p></div>
              <span class="pill">Audit log</span>
            </div>
            <div id="dashActivity"></div>
          </div>
        </div>
        <div class="note">ℹ️ Data awal kosong. Prototipe menyimpan data hanya di browser ini. Untuk akses internet bersama oleh dua pengguna, versi produksi memerlukan database online dan autentikasi server.</div>
      </section>
      
      <section id="page-items" class="page hidden">
        <div class="pagehead">
          <div><div class="eyebrow">Data referensi</div><h1>Master Barang</h1><p class="sub">Kelola SKU, satuan, lokasi, dan saldo stok sistem.</p></div>
          <button class="btn primary" onclick="openItemModal()">＋ Tambah barang</button>
        </div>
        <div class="panel">
          <div class="toolbar">
            <input class="search" id="itemSearch" placeholder="Cari SKU atau nama barang…" oninput="renderItems()">
            <button class="btn" onclick="downloadCSV()">⇩ Export CSV</button>
            <button class="btn danger" onclick="deleteAllItems()">Hapus semua</button>
            <button class="btn" onclick="showPage('import')">Import Excel</button>
          </div>
          <div class="tablewrap">
            <table>
              <thead><tr><th>SKU</th><th>NAMA BARANG</th><th>LOKASI</th><th>SATUAN</th><th>STOK SISTEM</th><th>AKSI</th></tr></thead>
              <tbody id="itemsBody"></tbody>
            </table>
          </div>
          <div class="footnote" id="itemsCount"></div>
        </div>
      </section>

      <section id="page-import" class="page hidden">
        <div class="pagehead">
          <div><div class="eyebrow">Migrasi data</div><h1>Import Data Excel</h1><p class="sub">Masukkan master barang dan saldo stok awal dari sistem lama.</p></div>
          <button class="btn" onclick="downloadTemplate()">⇩ Download template CSV</button>
        </div>
        <div class="layout2">
          <div class="panel">
            <div class="panelhead">
              <div><h3>Upload file</h3><p>Format .xlsx, .xls, atau .csv</p></div>
              <span class="tag">Stok awal</span>
            </div>
            <div class="uploadbox">
              <div style="font-size:28px">⇧</div>
              <strong>Pilih file Excel/CSV</strong>
              <p class="muted">Kolom yang dikenali: SKU, Nama Barang, Lokasi, Satuan, Stok Awal</p>
              <input id="importFile" type="file" accept=".xlsx,.xls,.csv">
              <div class="footnote">File diproses di browser prototipe ini.</div>
            </div>
            <div class="field" style="margin-top:14px">
              <label>Mode import</label>
              <select id="importMode">
                <option value="skip">Tambah barang baru saja (aman)</option>
                <option value="replace">Perbarui data barang yang cocok termasuk stok (gunakan hati-hati)</option>
              </select>
            </div>
            <div class="note">Barang yang SKU-nya sudah ada akan dilewati dalam mode aman. Mode pembaruan dapat mengubah saldo stok langsung dan sebaiknya hanya digunakan untuk setup awal.</div>
            <button class="btn primary" id="processImport" disabled onclick="commitImport()">Validasi & import data</button>
            <div id="importMessage"></div>
          </div>
          <div class="panel">
            <div class="panelhead">
              <div><h3>Format kolom yang disarankan</h3><p>Unduh template untuk menghindari kesalahan pemetaan.</p></div>
            </div>
            <div class="tablewrap">
              <table>
                <thead><tr><th>Kolom</th><th>Contoh</th><th>Wajib?</th></tr></thead>
                <tbody>
                  <tr><td>SKU</td><td>BRG001</td><td><span class="pill green">Ya</span></td></tr>
                  <tr><td>Nama Barang</td><td>Baut M8</td><td><span class="pill green">Ya</span></td></tr>
                  <tr><td>Lokasi</td><td>Rak A01</td><td><span class="pill">Tidak</span></td></tr>
                  <tr><td>Satuan</td><td>PCS</td><td><span class="pill">Tidak</span></td></tr>
                  <tr><td>Stok Awal</td><td>100</td><td><span class="pill green">Ya</span></td></tr>
                </tbody>
              </table>
            </div>
            <div id="previewArea" style="margin-top:16px"></div>
          </div>
        </div>
      </section>

      <section id="page-opname" class="page hidden">
        <div class="pagehead">
          <div><div class="eyebrow">Stock verification</div><h1>Stok Opname</h1><p class="sub">Catat jumlah fisik, bandingkan selisih, lalu setujui penyesuaian.</p></div>
          <div><button class="btn" onclick="exportOpname()">⇩ Export hasil opname</button> <button class="btn danger" onclick="deleteAllOpnames()">Hapus semua</button> <button class="btn primary" onclick="startOpname()">＋ Sesi opname baru</button></div>
        </div>
        <div class="cards" id="opStats"></div>
        <div class="panel">
          <div class="panelhead">
            <div><h3>Daftar penghitungan</h3><p>Selisih tidak mengubah stok sistem sampai disetujui.</p></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
              <input class="search" id="opSearch" placeholder="Cari SKU/kode barang, nama, lokasi atau ID opname…" oninput="renderOpname()" style="min-width:280px">
              <select class="user-select" id="opFilter" onchange="renderOpname()">
                <option value="all">Semua status</option>
                <option value="draft">Draft</option>
                <option value="pending">Menunggu persetujuan</option>
                <option value="approved">Disetujui</option>
              </select>
              <select class="user-select" id="opGroupFilter" onchange="renderOpname()">
                <option value="all">Semua area</option>
                <option value="Overhoul">Overhoul</option>
                <option value="GD 1">GD 1</option>
                <option value="GD 2">GD 2</option>
                <option value="GD 3">GD 3</option>
              </select>
            </div>
          </div>
          <div class="tablewrap">
            <table>
              <thead><tr><th>TANGGAL / SESI</th><th>SKU / BARANG</th><th>LOKASI</th><th>SISTEM</th><th>FISIK</th><th>SELISIH</th><th>STATUS</th><th>CATATAN</th><th>AKSI</th></tr></thead>
              <tbody id="opBody"></tbody>
            </table>
          </div>
          <div class="footnote">Persetujuan dicatat berdasarkan pengguna aktif. Untuk penggunaan produksi, identitas pengguna harus diverifikasi oleh server.</div>
        </div>
      </section>

      <section id="page-reports" class="page hidden">
        <div class="pagehead">
          <div><div class="eyebrow">Kontrol & audit</div><h1>Laporan & Riwayat</h1><p class="sub">Telusuri perubahan saldo, import, dan persetujuan opname.</p></div>
          <button class="btn" onclick="downloadLogs()">⇩ Export riwayat CSV</button>
        </div>
        <div class="panel">
          <div class="toolbar"><input class="search" id="logSearch" placeholder="Cari aktivitas, pengguna, SKU…" oninput="renderLogs()"></div>
          <div class="tablewrap">
            <table>
              <thead><tr><th>WAKTU</th><th>AKTIVITAS</th><th>DETAIL</th><th>PENGGUNA</th></tr></thead>
              <tbody id="logsBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="page-findings" class="page hidden">
        <div class="pagehead">
          <div><div class="eyebrow">Barang di luar stok</div><h1>Temuan</h1><p class="sub">Simpan barang yang ditemukan di warehouse tetapi belum tercatat di stok sistem.</p></div>
          <div><button class="btn" onclick="exportFindings()">⇩ Export temuan</button> <button class="btn primary" onclick="openFindingModal()">＋ Tambah temuan</button></div>
        </div>
        <div class="panel">
          <div class="toolbar"><input class="search" id="findingSearch" placeholder="Cari SKU, nama barang, lokasi, atau catatan…" oninput="renderFindings()"></div>
          <div class="tablewrap">
            <table>
              <thead><tr><th>TANGGAL</th><th>KODE BARANG</th><th>NAMA BARANG</th><th>LOKASI</th><th>SATUAN</th><th>QTY TEMUAN</th><th>CATATAN</th><th>PENGGUNA</th><th>AKSI</th></tr></thead>
              <tbody id="findingsBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <div class="footer">Warehouse Stock Prototype v0.7 · Data awal kosong · Untuk simulasi, bukan database produksi</div>
    </div>
  </main>
</div>
<div id="modalRoot"></div><div id="toastRoot"></div>
<script>
let state={items:[],opnames:[],findings:[],logs:[],staged:[],currentPage:'dashboard'};
function load(){try{const s=JSON.parse(localStorage.getItem('warehouseStockProtoV2'));if(s&&Array.isArray(s.items)){state={...state,...s,findings:Array.isArray(s.findings)?s.findings:[]};return}}catch(e){}state={items:[],opnames:[],findings:[],logs:[],staged:[],currentPage:'dashboard'};log('Inisialisasi','Workspace baru dibuat dengan data kosong',user());save()}
function save(){try{localStorage.setItem('warehouseStockProtoV2',JSON.stringify(state))}catch(e){}}
function user(){return document.getElementById('userSelect')?.value||'Pengguna 1'}function now(){return new Date().toLocaleString('id-ID',{dateStyle:'short',timeStyle:'short'})}function log(action,detail,by=user()){state.logs.unshift({time:now(),action,detail,user:by});state.logs=state.logs.slice(0,300);save()}function toast(msg){const root=document.getElementById('toastRoot');root.innerHTML='<div class="toast">'+esc(msg)+'</div>';setTimeout(()=>root.innerHTML='',2600)}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function fmt(n){return Number(n||0).toLocaleString('id-ID')}
const pageNames={dashboard:'Dashboard',items:'Master Barang',import:'Import Excel',opname:'Stok Opname',reports:'Laporan & Riwayat',findings:'Temuan'};
function showPage(p){state.currentPage=p;document.querySelectorAll('.page').forEach(e=>e.classList.add('hidden'));document.getElementById('page-'+p).classList.remove('hidden');document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===p));document.getElementById('crumb').textContent=pageNames[p];renderAll()}
document.getElementById('nav').addEventListener('click',e=>{const b=e.target.closest('button[data-page]');if(b)showPage(b.dataset.page)});document.getElementById('userSelect').addEventListener('change',()=>{document.getElementById('avatar').textContent=user().slice(0,1);toast('Pengguna aktif: '+user())});
function renderAll(){renderDashboard();renderItems();renderOpname();renderLogs();renderFindings()}
function renderDashboard(){const total=state.items.reduce((s,i)=>s+Number(i.stock||0),0),low=state.items.filter(i=>Number(i.stock)<=15).length,pending=state.opnames.filter(o=>o.status==='pending').length;document.getElementById('stats').innerHTML=[['Total SKU',fmt(state.items.length),'Master barang','▤'],['Total unit stok',fmt(total),'Akumulasi stok sistem','▦'],['Stok rendah / kosong',fmt(low),'Batas demo: ≤ 15 unit','⚑'],['Opname menunggu',fmt(pending),'Perlu ditinjau','☷']].map(x=>`<div class="stat"><div class="stat-top"><span>${x[1]==='x'?'':x[0]}</span><span class="stat-icon">${x[3]}</span></div><div class="stat-num">${x[1]}</div><div class="stat-note">${x[2]}</div></div>`).join('');document.getElementById('dashItems').innerHTML=state.items.slice(0,6).map(i=>`<tr><td><div class="sku">${esc(i.sku)}</div><div class="muted">${esc(i.name)}</div></td><td>${esc(i.location||'—')}</td><td><b>${fmt(i.stock)}</b> ${esc(i.unit||'')}</td><td>${Number(i.stock)<=15?'<span class="pill amber">Stok rendah</span>':'<span class="pill green">Tersedia</span>'}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">Belum ada barang. Import Excel atau tambah barang.</td></tr>';document.getElementById('dashActivity').innerHTML=state.logs.slice(0,5).map(l=>`<div class="activity"><div class="dot"></div><div><strong>${esc(l.action)}</strong><p>${esc(l.detail)}</p><p>${esc(l.time)} · ${esc(l.user)}</p></div></div>`).join('')||'<div class="empty">Belum ada aktivitas</div>';document.getElementById('opStats').innerHTML=''}
function renderItems(){const q=(document.getElementById('itemSearch')?.value||'').toLowerCase(),arr=state.items.filter(i=>(i.sku+' '+i.name+' '+i.location).toLowerCase().includes(q));const body=document.getElementById('itemsBody');if(!body)return;body.innerHTML=arr.map(i=>`<tr><td class="sku">${esc(i.sku)}</td><td><b>${esc(i.name)}</b></td><td>${esc(i.location||'—')}</td><td>${esc(i.unit||'—')}</td><td><b>${fmt(i.stock)}</b></td><td><button class="btn small" onclick="openItemModal('${encodeURIComponent(i.sku)}')">Edit</button> <button class="btn small danger" onclick="deleteItem('${encodeURIComponent(i.sku)}')">Hapus</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">Barang tidak ditemukan.</td></tr>';document.getElementById('itemsCount').textContent=`Menampilkan ${arr.length} dari ${state.items.length} SKU`}
