function editOp(id){const o=state.opnames.find(x=>x.id===id);if(!o)return;const groups=['Overhoul','GD 1','GD 2','GD 3'];document.getElementById('modalRoot').innerHTML=`<div class="modalback" onclick="if(event.target===this)closeModal()"><div class="modal"><h2>Edit hasil penghitungan</h2><p class="sub">Pilih area untuk pengelompokan dan filter daftar.</p><div class="formgrid"><div class="field span2"><label>Area / Kelompok *</label><select id="eGroup">${groups.map(g=>`<option value="${g}" ${o.group===g?'selected':''}>${g}</option>`).join('')}</select></div><div class="field span2"><label>Catatan</label><textarea id="eNote">${esc(o.note||'')}</textarea></div></div><div class="modalactions"><button class="btn" onclick="closeModal()">Batal</button><button class="btn primary" onclick="saveOpEdit('${o.id}')">Simpan</button></div></div></div>`}function saveOpEdit(id){const o=state.opnames.find(x=>x.id===id);if(!o)return;const group=document.getElementById('eGroup').value,note=document.getElementById('eNote').value.trim();o.group=group;o.note=note;log('Edit hasil penghitungan',`${o.id}: area ${group}; catatan diperbarui`);save();closeModal();renderAll();toast('Perubahan penghitungan disimpan')}
function approveOp(id){const o=state.opnames.find(x=>x.id===id);if(!o||o.status!=='pending')return;if(user()===o.createdBy)return toast('Persetujuan ditolak: harus disetujui pengguna yang berbeda dari penghitung. Ganti Pengguna Aktif ke pengguna kedua.');let item=state.items.find(i=>i.sku.toLowerCase()===o.sku.toLowerCase()&&String(i.location||'').toLowerCase()===String(o.location||'').toLowerCase());if(!item&&o.system===0){if(!confirm(`SKU ${o.sku} di lokasi ${o.location} belum ada di master. Buat lokasi/barang ini dengan stok fisik ${o.physical} setelah persetujuan?`))return;item={sku:o.sku,name:o.name,location:o.location,unit:o.unit||'PCS',stock:0};}else if(!item)return toast('Barang/lokasi tidak ditemukan.');if(Number(item.stock)!==Number(o.system))return toast('Stok sistem berubah sejak penghitungan. Buat hitungan ulang sebelum persetujuan.');if(!confirm(`Setujui penyesuaian ${o.sku} @ ${o.location}? Stok saat ini ${item.stock}, hasil hitung fisik ${o.physical}. Persetujuan dicatat atas nama ${user()}.`))return;const previous=item.stock;if(!state.items.includes(item))state.items.push(item);item.stock=o.physical;o.status='approved';o.approvedBy=user();o.approvedAt=now();log('Persetujuan penyesuaian',`${o.id} ${o.sku} @ ${o.location}: stok ${previous} → ${item.stock}; selisih ${o.diff}`,user());save();renderAll();toast('Penyesuaian stok disetujui')}
