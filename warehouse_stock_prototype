function downloadText(name,text,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff',text],{type}));a.download=name;a.click();URL.revokeObjectURL(a.href)}function csvq(v){return '"'+String(v??'').replace(/"/g,'""')+'"'}
let staged=[];document.getElementById('importFile').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;try{let rows;if(file.name.toLowerCase().endsWith('.csv')){const text=await file.text();rows=parseCSV(text)}else{if(!window.XLSX)throw new Error('Pustaka Excel belum termuat. Periksa koneksi internet atau gunakan CSV.');const buf=await file.arrayBuffer(),wb=XLSX.read(buf,{type:'array'});rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:''})}staged=normalizeRows(rows);renderPreview(file.name);document.getElementById('processImport').disabled=staged.length===0;document.getElementById('importMessage').innerHTML=`<div class="success">${staged.length} baris terbaca. Periksa pratinjau sebelum import.</div>`}catch(err){staged=[];document.getElementById('processImport').disabled=true;document.getElementById('importMessage').innerHTML=`<div class="note">Gagal membaca file: ${esc(err.message)}</div>`}});
function parseCSV(text){const lines=text.replace(/^\ufeff/,'').split(/\r?\n/).filter(x=>x.trim());if(!lines.length)return [];const parseLine=line=>{let out=[],v='',q=false;for(let i=0;i<line.length;i++){const c=line[i];if(c==='"'&&q&&line[i+1]==='"'){v+='"';i++}else if(c==='"')q=!q;else if(c===','&&!q){out.push(v);v=''}else v+=c}out.push(v);return out};const headers=parseLine(lines[0]).map(h=>h.trim());return lines.slice(1).map(l=>{const vals=parseLine(l),o={};headers.forEach((h,i)=>o[h]=vals[i]??'');return o})}
function normalizeRows(rows){return rows.map((r,idx)=>{const get=(names)=>{const key=Object.keys(r).find(k=>names.includes(k.toLowerCase().trim().replace(/[_-]/g,' ')));return key===undefined?'':r[key]};const sku=String(get(['sku','kode barang','kode','item code','itemcode'])).trim(),name=String(get(['nama barang','nama','item name','description','barang'])).trim(),loc=String(get(['lokasi','lokasi rak','location','bin'])).trim(),unit=String(get(['satuan','unit','uom'])).trim()||'PCS',raw=String(get(['stok awal','stok sistem','stok','qty','quantity','on hand','stock'])).trim().replace(/\.(?=\d{3}(\D|$))/g,'').replace(',','.');const stock=Number(raw);return {sku,name,location:loc,unit,stock,row:idx+2,valid:!!sku&&!!name&&raw!==''&&Number.isFinite(stock)&&stock>=0,error:!sku?'SKU kosong':!name?'Nama barang kosong':raw===''?'Stok kosong':!Number.isFinite(stock)?'Format stok tidak valid':stock<0?'Stok negatif':''}})}
function renderPreview(file){const area=document.getElementById('previewArea');const dup=new Set();staged.forEach(r=>{const k=r.sku.toLowerCase();if(k&&dup.has(k)){r.valid=false;r.error='SKU duplikat di file'}dup.add(k)});const good=staged.filter(r=>r.valid).length,bad=staged.length-good;area.innerHTML=`<div class="panelhead"><div><h3>Pratinjau: ${esc(file)}</h3><p>${good} valid · ${bad} perlu diperbaiki</p></div><span class="pill ${bad?'amber':'green'}">${bad?'Perlu pemeriksaan':'Siap'}</span></div><div class="tablewrap"><table><thead><tr><th>BARIS</th><th>SKU</th><th>NAMA</th><th>STOK</th><th>VALIDASI</th></tr></thead><tbody>${staged.slice(0,10).map(r=>`<tr><td>${r.row}</td><td>${esc(r.sku||'—')}</td><td>${esc(r.name||'—')}</td><td>${esc(r.stock)}</td><td>${r.valid?'<span class="pill green">Valid</span>':`<span class="pill red">${esc(r.error)}</span>`}</td></tr>`).join('')}</tbody></table></div>${staged.length>10?`<p class="footnote">Menampilkan 10 dari ${staged.length} baris.</p>`:''}`}
function commitImport(){if(!staged.length)return;const mode=document.getElementById('importMode').value,valid=staged.filter(r=>r.valid);let added=0,updated=0,skipped=0;for(const r of valid){const old=state.items.find(i=>i.sku.toLowerCase()===r.sku.toLowerCase());if(old){if(mode==='replace'){Object.assign(old,{name:r.name,location:r.location,unit:r.unit,stock:r.stock});updated++}else skipped++}else{state.items.push({sku:r.sku,name:r.name,location:r.location,unit:r.unit,stock:r.stock});added++}}log('Import data Excel',`Valid ${valid.length}; tambah ${added}; perbarui ${updated}; lewati ${skipped}; gagal ${staged.length-valid.length}`);save();document.getElementById('importMessage').innerHTML=`<div class="success">Import selesai: ${added} barang ditambahkan, ${updated} diperbarui, ${skipped} dilewati, ${staged.length-valid.length} baris gagal validasi.</div>`;toast('Import selesai');renderAll()}
function startOpname(){document.getElementById('modalRoot').innerHTML=`<div class="modalback" onclick="if(event.target===this)closeModal()"><div class="modal"><h2>Input stok opname</h2><div class="formgrid"><div class="field"><label>Kode barang / SKU *</label><input id="oSku" placeholder="Ketik kode barang" list="opSkuList" oninput="fillOpItem()"><datalist id="opSkuList">${state.items.map(i=>`<option value="${esc(i.sku)}">${esc(i.name)} — ${esc(i.location)}</option>`).join('')}</datalist></div><div class="field"><label>Nama barang *</label><input id="oName" placeholder="Ketik nama barang"></div><div class="field"><label>Lokasi fisik / rak *</label><input id="oLoc" placeholder="Contoh: Rak A-01"></div><div class="field"><label>Satuan</label><input id="oUnit" value="PCS"></div><div class="field span2"><label>Jumlah fisik hasil hitung *</label><input id="oPhysical" type="number" min="0" step="any" placeholder="Masukkan hasil hitung"></div></div><div class="field"><label>Catatan / alasan selisih</label><textarea id="oNote" placeholder="Contoh: hitung ulang, barang rusak, salah picking…"></textarea></div><div class="note">Kode barang dan nama diketik manual. SKU yang sama di lokasi berbeda diperbolehkan sebagai baris opname terpisah. Jika kombinasi SKU + lokasi belum ada di master, stok sistem awalnya 0 dan barang/lokasi baru dibuat setelah disetujui.</div><div class="modalactions"><button class="btn" onclick="closeModal()">Batal</button><button class="btn primary" onclick="saveOpname()">Simpan hitungan</button></div></div></div>`}
function fillOpItem(){const sku=document.getElementById('oSku').value.trim().toLowerCase();const item=state.items.find(i=>i.sku.toLowerCase()===sku);if(item){document.getElementById('oName').value=item.name;document.getElementById('oUnit').value=item.unit||'PCS';if(!document.getElementById('oLoc').value)document.getElementById('oLoc').value=item.location||''}}
function saveOpname(){const sku=document.getElementById('oSku').value.trim(),name=document.getElementById('oName').value.trim(),location=document.getElementById('oLoc').value.trim(),unit=document.getElementById('oUnit').value.trim()||'PCS',physical=Number(document.getElementById('oPhysical').value),note=document.getElementById('oNote').value.trim();if(!sku||!name||!location)return toast('Kode barang, nama, dan lokasi wajib diisi.');if(document.getElementById('oPhysical').value===''||!Number.isFinite(physical)||physical<0)return toast('Jumlah fisik harus angka nol atau lebih.');const item=state.items.find(i=>i.sku.toLowerCase()===sku.toLowerCase()&&String(i.location||'').toLowerCase()===location.toLowerCase());const sameSku=state.items.find(i=>i.sku.toLowerCase()===sku.toLowerCase());const existing=state.opnames.find(o=>o.status==='pending'&&o.sku.toLowerCase()===sku.toLowerCase()&&String(o.location||'').toLowerCase()===location.toLowerCase());if(existing){existing.physical=Number(existing.physical)+physical;existing.diff=existing.physical-Number(existing.system);existing.note=[existing.note,note,'Qty temuan digabung ke hitungan awal'].filter(Boolean).join(' | ');log('Tambah qty ke hitungan opname',`${existing.id}: ${sku} @ ${location}; qty tambahan ${physical}; total fisik ${existing.physical}, selisih ${existing.diff}`);save();closeModal();renderAll();toast(`Qty ditambahkan ke hitungan awal ${existing.id}`);return}const op={id:'OP-'+Date.now().toString().slice(-7),time:now(),sku,name,location,unit,system:item?Number(item.stock):0,physical,diff:physical-(item?Number(item.stock):0),newLocation:!item,systemItemId:item?item.sku+'|'+(item.location||''):'',note,createdBy:user(),status:'pending',approvedBy:'',approvedAt:''};if(sameSku&&!item)op.note=(op.note?op.note+' | ':'')+'SKU sama di lokasi berbeda; stok sistem lokasi ini diasumsikan 0.';state.opnames.unshift(op);log('Input stok opname',`${op.id}: ${sku} @ ${location}, sistem ${op.system}, fisik ${physical}, selisih ${op.diff}`);save();closeModal();renderAll();toast('Hitungan tersimpan, menunggu persetujuan')}
function renderOpname(){const body=document.getElementById('opBody');if(!body)return;const pending=state.opnames.filter(o=>o.status==='pending').length,approved=state.opnames.filter(o=>o.status==='approved').length,diffs=state.opnames.filter(o=>o.status!=='draft'&&o.diff!==0).length;document.getElementById('opStats').innerHTML=[['Menunggu persetujuan',pending,'amber'],['Sudah disetujui',approved,'green'],['Hitungan berselisih',diffs,'red'],['Total sesi',state.opnames.length,'']].map(a=>`<div class="stat"><div class="stat-top">${a[0]}<span class="pill ${a[2]}">${a[2]||'Opname'}</span></div><div class="stat-num">${fmt(a[1])}</div><div class="stat-note">Seluruh riwayat opname</div></div>`).join('');const filter=document.getElementById('opFilter')?.value||'all',groupFilter=document.getElementById('opGroupFilter')?.value||'all',q=(document.getElementById('opSearch')?.value||'').trim().toLowerCase(),arr=state.opnames.filter(o=>(filter==='all'||o.status===filter)&&(groupFilter==='all'||(o.group||'')===groupFilter)&&[o.id,o.time,o.sku,o.name,o.location,o.unit,o.status,o.createdBy,o.group].join(' ').toLowerCase().includes(q));body.innerHTML=arr.map(o=>`<tr><td><b>${esc(o.id)}</b><div class="muted">${esc(o.time)}</div></td><td><span class="sku">${esc(o.sku)}</span><div>${esc(o.name)}</div></td><td>${esc(o.location||'—')}<div class="muted">${esc(o.group||'Belum dipilih')}</div></td><td>${fmt(o.system)}</td><td>${fmt(o.physical)}</td><td class="${o.diff>0?'diffpos':o.diff<0?'diffneg':''}">${o.diff>0?'+':''}${fmt(o.diff)}</td><td>${o.status==='approved'?'<span class="pill green">Disetujui</span>':o.status==='pending'?'<span class="pill amber">Menunggu</span>':'<span class="pill">Draft</span>'}<div class="muted">${esc(o.createdBy)}</div></td><td><div>${esc(o.note||'—')}</div><button class="btn small" onclick="editOpNote('${o.id}')">${o.note?'Edit catatan':'＋ Catatan'}</button></td><td>${o.status==='pending'?`<button class="btn small primary" onclick="approveOp('${o.id}')">Setujui